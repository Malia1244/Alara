# Copy this file to .env and fill in your values from Supabase:
# Project Settings → API

# Must start with https:// and end with .supabase.co (NOT the publishable key)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Secret key (service_role) — keep this private
SUPABASE_SERVICE_ROLE_KEY=your_secret_key_here

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here
